# Copy this file to .env.local and fill in your values.
# The app runs with built-in seed data if these are left blank,
# so you can develop the UI before wiring a real Supabase project.

# --- Supabase (from your project's API settings) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed to mint signed download URLs, write licenses from the
# payment webhook, and upload software. Keep this secret — never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (test keys from dashboard.paystack.com/#/settings/developers) ---
# Leave blank to use the mock checkout flow (no real charge).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Platform commission kept on each sale (percent). Default 15 if unset.
PLATFORM_COMMISSION_PERCENT=15

# Affiliate commission paid to referrers per sale (percent). Default 10 if unset.
AFFILIATE_PERCENT=10

# USD→NGN rate for charging USD-priced products in NGN. Default 1600 if unset.
NEXT_PUBLIC_USD_TO_NGN=1350

# Base URL used for payment redirects/callbacks in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Rate limiting (Upstash Redis — free tier, optional but recommended) ---
# Without these, rate limits are best-effort per-instance (reset on cold starts).
# With them, limits are enforced atomically across all serverless instances.
# Create a free database at console.upstash.com → REST API → copy URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: set DEMO_MODE=1 to explicitly allow open demo identities (NEVER in prod).
# DEMO_MODE=

# --- Analytics (PostHog — free tier, optional) ---
# Leave blank to disable. Get a key at posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Admin ---
# Comma-separated emails allowed into /admin (must match the signed-in user).
ADMIN_EMAILS=doyinacademy@gmail.com

# --- Email ---
# Option A: Gmail SMTP (easiest). Enable 2-Step Verification, then create an
# App Password (Google Account → Security → App passwords) and paste it below.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=

# Option B: Resend (custom domain). Used only if Gmail vars are blank.
RESEND_API_KEY=

# Display From. With Gmail, the address is forced to your Gmail account.
EMAIL_FROM=DoyinSoft <youraddress@gmail.com>
