# Copy this file to .env.local and fill in your values.
# The app runs with built-in seed data if these are left blank,
# so you can develop the UI before wiring a real Supabase project.

# --- Supabase (from your project's API settings) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed to mint signed download URLs, write licenses from the
# payment webhook, and upload software. Keep this secret — never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (test keys from dashboard.paystack.com/#/settings/developers) ---
# Leave blank to use the mock checkout flow (no real charge).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Base URL used for payment redirects/callbacks in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
