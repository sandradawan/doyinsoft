# Copy this file to .env.local and fill in your values.
# The app runs with built-in seed data if these are left blank,
# so you can develop the UI before wiring a real Supabase project.

# --- Supabase (from your project's API settings) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed to mint signed download URLs, write licenses from the
# payment webhook, and upload software. Keep this secret — never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (test keys from dashboard.paystack.com/#/settings/developers) ---
# Leave blank to use the mock checkout flow (no real charge).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Platform commission kept on each sale (percent). Default 15 if unset.
PLATFORM_COMMISSION_PERCENT=15

# USD→NGN rate for charging USD-priced products in NGN. Default 1600 if unset.
NEXT_PUBLIC_USD_TO_NGN=1350

# Base URL used for payment redirects/callbacks in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin ---
# Comma-separated emails allowed into /admin (must match the signed-in user).
ADMIN_EMAILS=doyinacademy@gmail.com

# --- Email (Resend — free tier; resend.com/api-keys) ---
# Leave blank to skip emails (license + approval notices just log to the server).
RESEND_API_KEY=
EMAIL_FROM=DoyinSoft <onboarding@resend.dev>
